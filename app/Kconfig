choice
	prompt "Heartbeat Period"
	default HEARTBEAT_500MS

config HEARTBEAT_100MS
	bool "Very Fast (100ms)"

config HEARTBEAT_500MS
	bool "Fast (500ms)"

config HEARTBEAT_1000MS
	bool "Medium (1s)"

config HEARTBEAT_2000MS
	bool "Slow (2s)"
endchoice

config APP_HEARTBEAT_PERIOD_MS
	int
	range 100 2000
    default 100 if HEARTBEAT_100MS
	default 500 if HEARTBEAT_500MS
	default 1000 if HEARTBEAT_1000MS
	default 2000 if HEARTBEAT_2000MS
	default 500

source "Kconfig.zephyr"